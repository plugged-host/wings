# plugged.host: Calagopus Wings (github.com/plugged-host/wings) on a game node (plugged-host/README.md).
# --config is pinned: without it wings-rs falls back to /etc/pelican/config.yml.
[Unit]
Description=Calagopus Wings Daemon
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
User=root
KillMode=process
LimitNOFILE=4096
PIDFile=/run/calagopus-wings/daemon.pid
ExecStart=/usr/local/bin/calagopus-wings --config /etc/calagopus-wings/config.yml
Restart=on-failure
StartLimitInterval=180
StartLimitBurst=30
RestartSec=5s

[Install]
WantedBy=multi-user.target
